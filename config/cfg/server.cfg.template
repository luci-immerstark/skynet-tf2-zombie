// SKYNET TF2 Zombie Infection: este arquivo vira o server.cfg a cada inicio, com os valores das variaveis de ambiente.
// Nao coloque senhas aqui: use as variaveis (veja o README).
log on

rcon_password "${RCON_PASSWORD}"
hostname "${SERVER_HOSTNAME}"
sv_password "${SERVER_PASSWORD}"
sv_contact ""
sv_tags "${SERVER_TAGS}"
sv_region ${SERVER_REGION}

// Os mapas zi_ sao oficiais: os jogadores ja tem todos, nao precisa de FastDL
sv_downloadurl "${DOWNLOAD_URL}"
sv_allowdownload 1
sv_allowupload 0

// Seguranca: so mapas oficiais podem mandar comandos para o console do servidor
sv_allow_point_servercommand "official"

// Sem SourceTV: todas as vagas sao de jogadores
tv_enable 0

// Zombie Infection: o modo vem dentro dos mapas zi_ e cuida dos times sozinho
mapcyclefile "mapcycle.txt"
mp_timelimit 30
mp_autoteambalance 0
mp_teams_unbalance_limit 0

sv_quota_stringcmdspersecond 400
